manifest {
  name            = 'nf-gene-verify'
  author          = 'Xiandong Meng'
  homePage        = 'https://github.com/fischbachlab/nf-gene-verify'
  description     = 'Annotation-free gene presence/absence verification (NCBI protein DB + blastx + optional nr round)'
  mainScript      = 'main.nf'
  version         = '0.1.0'
  defaultBranch   = 'main'
  nextflowVersion = '>=22.10.0'
}

params {
  // ── Input (one of) ──────────────────────────────────────────
  seedfile = null          // CSV: sampleName,fasta
  fasta    = null          // a single assembly
  project  = null          // label for a single --fasta run

  // ── Required ────────────────────────────────────────────────
  outdir   = "s3://genomics-workflow-core/Results/gene-verify/"

  // ── Gene list ───────────────────────────────────────────────
  // Staged as a file so the exact list is published with the results.
  genes    = "$baseDir/genes.txt"

  // ── Round 1: protein DB + blastx screen ─────────────────────
  // ── Round 1: the protein reference panel ───────────────────
  // SEVERAL alleles per gene, not one. A single reference measures similarity
  // to one strain's allele, so a gene that varies between isolates reads as
  // 'divergent' or 'partial' while plainly present. On LM088-RCB001 four of
  // eight genes did exactly that -- agrB 49.2%, fosB 64.3%, sdrF 42.9%
  // identity in round 1, all 98-100% against nr -- because the reference set
  // held one allele per gene.
  retmax        = 200      // NCBI records fetched per gene before selection
  // References KEPT per gene after dedup + diversity selection. 8 proved too
  // few once the query went genus-wide: with 13 staphylococcal species in the
  // result set, 8 slots cannot hold even one allele each, and the near-exact
  // S. epidermidis allele was being selected out. 20 restored agrA to 99.2%.
  max_alleles   = 20
  // The gene query is genus-wide, so without this the panel is dominated by
  // whichever species has most records -- usually S. aureus, whose AgrA is
  // ~15% divergent from S. epidermidis. '' disables.
  prefer_organism = 'Staphylococcus epidermidis'
  // Drop references shorter than this fraction of the gene's MEDIAN reference
  // length. call_genes.py ranks coverage first, so a truncated reference wins
  // on a short spurious locus: a fragmentary sdrF reference called a 222 bp
  // locus at 2.43 Mb instead of the real gene. 0 disables.
  min_len_frac  = 0.5
  // data/<gene>_seed.faa is auto-discovered (predefined_dir is staged as
  // ./data) and APPENDED after diversity selection, so a known-matching
  // allele is never trimmed. Currently seeded: agrB, sdrF, sdrH.
  // SCCmec is a mobile cassette, not a gene, so its references come from a
  // predefined FASTA (data/sccmec_proteins.faa) built once by
  // bin/fetch_sccmec_db.py from seven whole-cassette GenBank records:
  // AB033763 D86934 AB037671 AB063172 AB121219 AF411935 FJ390057.
  // Required only if 'SCCmec' appears in the gene list.
  predefined_dir = "$baseDir/data"
  // core=1 only by default. true uses EVERY protein in a predefined database
  // (core=0 too) -- for SCCmec that means all cassette proteins rather than
  // just the mec/ccr complexes, which raises false positives since cassettes
  // carry transposases and hypothetical proteins found across staphylococcal
  // genomes.
  predefined_all = false
  // Predefined sets are curated lists, so --max-alleles does NOT trim them.
  // 0 = no cap; set a number only if a predefined FASTA is unmanageably large.
  predefined_max = 0

  refseq_only   = false    // RefSeq WP_ records are non-redundant
                           // representatives and COLLAPSE allelic diversity;
                           // true restores the old one-allele behaviour
  evalue        = '1e-5'
  // blastx SEG-masks low-complexity tracts in the TRANSLATED QUERY by default,
  // and those residues are dropped from the alignment entirely. The Sdr family
  // is built on serine-aspartate repeats, which is exactly what SEG removes:
  // on LM088-RCB001 every sdrH alignment started at subject residue 167 with
  // 'yes' and at residue 1 with 'no' -- the N-terminal 166 aa were masked out,
  // alignment length 270 -> 458 aa. That read as 'partial' at 77.8% coverage
  // for a gene that is in fact full length and aligns end to end.
  //
  // CAUTION: masking is also what suppresses cross-matching between the shared
  // B-repeats of SdrC/SdrD/SdrE/SdrF. With 'no' those paralogues match each
  // other more readily, so this relies on PRODUCT_FILTERS and full-length
  // identity to keep them apart -- do not treat 'no' as free.
  blastx_seg    = 'no'
  // These three mirror call_genes.py's ID_MIN, COV_MIN, GAP exactly, so the
  // defaults reproduce the shell pipeline's behaviour.
  identity_min  = 90.0
  coverage_min  = 80.0
  gap           = 5000     // genomic clustering gap (bp)

  // ── Round 2: nr verification (optional) ─────────────────────
  verify_nr = false
  // Prebuilt nr BLAST db PREFIX, not the directory:
  //   /mnt/efs/databases/Blast/nr/db/nr
  // Empty string => NCBI remote BLAST, which is queue-dependent and can take
  // hours. Local is strongly preferred.
  nr_db     = '/mnt/efs/databases/Blast/nr/db/nr'
  flank     = 300
  hitlist   = 100          // remote mode only

  // ── Local nr search: batching ───────────────────────────────
  // blastx streams the whole database regardless of how many query sequences
  // it is given, so N loci in ONE query file cost one scan of nr instead of N.
  // With 8 genes and ~83 nr volumes on EFS that is the dominant saving.
  //   0 -> all loci in one task  (one scan; fastest, least I/O)
  //   1 -> one task per locus    (fully parallel; only helps if EFS can serve
  //                               concurrent readers)
  //   N -> batches of N
  nr_batch_size = 0
  // Concurrent readers of nr contend for EFS throughput, so cap the fan-out.
  nr_max_forks  = 4

  // Mirror run_nr_verification.py's own defaults so results are unchanged.
  nr_evalue           = '1e-10'
  nr_max_target_seqs  = 100
  nr_max_hsps         = 1
  // Same reasoning as blastx_seg. Round 2 must match round 1 or the two rounds
  // measure different things: with masking on, sdrH scored 100% identity over
  // the 270 unmasked residues while the full-length figure was 89.7%, which is
  // how a worse reference came to look like an exact match.
  nr_seg              = 'no'

  // ── Round 2: interpreting nr titles ─────────────────────────
  // Most nr deflines give a product name, not a gene symbol:
  // 'accessory gene regulator B' is agrB, 'Beta-lactamase' is blaZ. Matching
  // the symbol alone falsely flagged 4 of 8 genes on LM088-RCB001 where every
  // top hit was in fact correct. bin/finalize_calls.py carries a per-gene
  // accept/reject pattern table; override or extend it with a TSV of
  // 'gene<TAB>accept<TAB>reject' regexes.
  gene_patterns = null
  // A lower-ranked hit may confirm, but only at >= this fraction of the top
  // overlapping hit's bitscore. sdrH confirms on rank 4 because ranks 1-3 are
  // the ambiguous 'fibrinogen-binding protein'.
  nr_min_bitscore_frac = 0.80
  // Noted (not enforced) when the confirming hit's organism is outside this
  // genus -- e.g. an AgrB hit in Veillonella.
  expect_genus = 'Staphylococcus'

  // ── Runtime ─────────────────────────────────────────────────
  container = 'fischbachlab/gene-verify:latest'

  help = false
}

includeConfig "$baseDir/conf/aws_batch.config"

process {
  executor = 'awsbatch'
  queue    = 'default-maf-pipelines'
  cleanup  = true
  cache    = false

  maxRetries = 2

  // BUILD_PROTEIN_DB is the exception: it is the only networked step and the
  // only one worth reusing across -resume, so it keeps its cache.
  withName: BUILD_PROTEIN_DB {
    cache = true
  }
}

profiles {

  // Local docker on the EC2 instance -- closest to the original
  // `docker run ... run_pipeline.sh` invocation.
  local {
    process {
      executor = 'local'
      cache    = true
      cleanup  = false
    }
    docker {
      enabled    = true
      runOptions = '-v /mnt/efs:/mnt/efs:ro'   // nr lives here
    }
    // Local blastx against nr is I/O bound on EFS; avoid piling tasks on.
    executor {
      cpus   = 16
      memory = '64 GB'
    }
  }

  awsbatch {
    process.executor = 'awsbatch'
    process.queue    = 'default-pipelines'
    docker.enabled   = true
    aws.region       = 'us-west-2'
  }

  // Round 1 only, no nr -- fast smoke test
  test {
    params.verify_nr = false
    params.retmax    = 5
  }
}

aws {
  region = 'us-west-2'
}

timeline { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/timeline.html" }
report   { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/report.html" }
trace    { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/trace.txt" }
dag      { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/dag.html" }
