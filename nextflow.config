manifest {
  name            = 'nf-gene-verify'
  author          = 'Xiandong Meng'
  homePage        = 'https://github.com/fischbachlab/nf-gene-verify'
  description     = 'Annotation-free gene presence/absence verification (NCBI protein DB + blastx + optional nr round)'
  mainScript      = 'main.nf'
  version         = '0.1.0'
  defaultBranch   = 'main'
  nextflowVersion = '>=22.10.0'
}

params {
  // ── Input (one of) ──────────────────────────────────────────
  seedfile = null          // CSV: sampleName,fasta
  fasta    = null          // a single assembly
  project  = null          // label for a single --fasta run

  // ── Required ────────────────────────────────────────────────
  outdir   = "s3://genomics-workflow-core/Results/gene-verify/"

  // ── Gene list ───────────────────────────────────────────────
  // Staged as a file so the exact list is published with the results.
  genes    = "$baseDir/genes.txt"

  // ── Round 1: protein DB + blastx screen ─────────────────────
  // ── Round 1: the protein reference panel ───────────────────
  // SEVERAL alleles per gene, not one. A single reference measures similarity
  // to one strain's allele, so a gene that varies between isolates reads as
  // 'divergent' or 'partial' while plainly present. On LM088-RCB001 four of
  // eight genes did exactly that -- agrB 49.2%, fosB 64.3%, sdrF 42.9%
  // identity in round 1, all 98-100% against nr -- because the reference set
  // held one allele per gene.
  retmax        = 200      // NCBI records fetched per gene before selection
  // References KEPT per gene after dedup + diversity selection. 8 proved too
  // few once the query went genus-wide: with 13 staphylococcal species in the
  // result set, 8 slots cannot hold even one allele each, and the near-exact
  // S. epidermidis allele was being selected out. 20 restored agrA to 99.2%.
  max_alleles   = 20
  // The gene query is genus-wide, so without this the panel is dominated by
  // whichever species has most records -- usually S. aureus, whose AgrA is
  // ~15% divergent from S. epidermidis. '' disables.
  prefer_organism = 'Staphylococcus epidermidis'
  // Drop references shorter than this fraction of the gene's MEDIAN reference
  // length. call_genes.py ranks coverage first, so a truncated reference wins
  // on a short spurious locus: a fragmentary sdrF reference called a 222 bp
  // locus at 2.43 Mb instead of the real gene. 0 disables.
  min_len_frac  = 0.5
  // data/<gene>_seed.faa is auto-discovered (predefined_dir is staged as
  // ./data) and APPENDED after diversity selection, so a known-matching
  // allele is never trimmed. Currently seeded: agrB, sdrF, sdrH.
  // SCCmec is a mobile cassette, not a gene, so its references come from a
  // predefined FASTA (data/sccmec_proteins.faa) built once by
  // bin/fetch_sccmec_db.py from seven whole-cassette GenBank records:
  // AB033763 D86934 AB037671 AB063172 AB121219 AF411935 FJ390057.
  // Required only if 'SCCmec' appears in the gene list.
  // Frozen reference panel. When set, every gene with a <gene>.fasta in this
  // directory is built from that file and NOTHING is fetched from NCBI, so
  // the panel -- and therefore the calls -- reproduce exactly.
  //
  // Unset by default, because the genus-wide query DRIFTS: between two runs
  // three weeks apart, 16 of 55 panels drew different references (fdh swapped
  // 7 of 20, aap 5, kdpB 4) and 13 calls moved for that reason alone, with no
  // code change behind any of them. Set this for anything that has to be
  // reproducible or compared across runs; leave it unset to pick up new
  // alleles. Build one with tools/freeze_panel.sh <results-dir> <panel-dir>.
  panel_dir = ''

  predefined_dir = "$baseDir/data"
  // core=1 only by default. true uses EVERY protein in a predefined database
  // (core=0 too) -- for SCCmec that means all cassette proteins rather than
  // just the mec/ccr complexes, which raises false positives since cassettes
  // carry transposases and hypothetical proteins found across staphylococcal
  // genomes.
  predefined_all = false
  // Predefined sets are curated lists, so --max-alleles does NOT trim them.
  // 0 = no cap; set a number only if a predefined FASTA is unmanageably large.
  predefined_max = 0
  // Whole-cassette GenBank records carry 36-67 aa CDS fragments of the core
  // genes alongside the full-length copies. call_genes.py ranks COVERAGE before
  // identity, so the shortest reference wins outright: a 67 aa mecI fragment
  // (AB037671_cds130) reached 100% coverage and put the SCCmec call on the bla
  // operon, 107 bp downstream of blaZ, since MecI is a BlaI homologue.
  // Drops 4 of 25 core=1 SCCmec proteins; leaves all 17 IS256 records.
  // 0 disables.
  predefined_min_len = 100

  refseq_only   = false    // RefSeq WP_ records are non-redundant
                           // representatives and COLLAPSE allelic diversity;
                           // true restores the old one-allele behaviour
  evalue        = '1e-5'
  // blastx SEG-masks low-complexity tracts in the TRANSLATED QUERY by default,
  // and those residues are dropped from the alignment entirely. The Sdr family
  // is built on serine-aspartate repeats, which is exactly what SEG removes:
  // on LM088-RCB001 every sdrH alignment started at subject residue 167 with
  // 'yes' and at residue 1 with 'no' -- the N-terminal 166 aa were masked out,
  // alignment length 270 -> 458 aa. That read as 'partial' at 77.8% coverage
  // for a gene that is in fact full length and aligns end to end.
  //
  // CAUTION: masking is also what suppresses cross-matching between the shared
  // B-repeats of SdrC/SdrD/SdrE/SdrF. With 'no' those paralogues match each
  // other more readily, so this relies on PRODUCT_FILTERS and full-length
  // identity to keep them apart -- do not treat 'no' as free.
  blastx_seg    = 'no'
  // These three mirror call_genes.py's ID_MIN, COV_MIN, GAP exactly, so the
  // defaults reproduce the shell pipeline's behaviour.
  identity_min  = 90.0
  coverage_min  = 80.0
  // Below this identity, call_genes.py reports 'homology_only' instead of
  // 'divergent'/'partial'. The match is then to another member of the same
  // SUPERFAMILY, not an allele of the gene: on LM088-RCB001 ermA/B/C all
  // landed on one native rRNA methyltransferase at 24-26%, msrA on a native
  // ABC-F protein at 26%, tetK on a native MFS pump at 25%, opp3D/E on
  // unrelated ABC transporters at ~29%. For scale, a genuine copy of these
  // same genes matches at ~100% (opp3B: 100.0% over 308/308 aa).
  // 40 is a judgement call, not a natural boundary -- embp (42.2%) is a real
  // cross-species orthologue and dfrG (39.5%) is background. 0 disables.
  homology_max  = 40.0
  // Minimum locus length before call_genes.py inspects reading frames. blastx
  // reports HSPs from any of six frames and clustering ignores frame, so a
  // frameshifted pseudogene looks exactly like an intact gene -- ebh/embp on
  // LM088-RCB001 scores 99.6% identity to an S. epidermidis Ebh-like protein
  // across 30.5 kb while carrying two frameshifts, at coordinates reproduced
  // identically by two independent panels. Such a locus is reported as
  // 'present_frameshift', with the junctions in the frameshift_at column.
  // 0 disables.
  frame_check_min_bp = 600
  // Genomic clustering gap (bp). Lowered from 5000: at 5000 the aap cluster
  // absorbed a detached 516 bp block of G5/E repeats 3,847 bp away and reported
  // an 8,506 bp locus for a 4,143 bp gene. At 2000 the coordinates match nr's
  // confirming hit exactly. Validated over 56 gene-calls across two panels --
  // only aap's coordinates change, no call changes, and the 30.5 kb ebh/embp
  // gene is unaffected. Below ~1400 the aap gene splits at its own internal
  // 1,341 bp gap.
  gap           = 2000

  // ── Round 2: nr verification (optional) ─────────────────────
  verify_nr = false
  // Run ONE nr scan for all samples instead of one per sample. blastx searches
  // every query sequence in a file against the database in a single pass, and
  // the query is ~100 kb per sample against a ~100 GB database -- so with 30
  // genomes this is a ~30x cut in the only cost that matters. Thresholds do
  // NOT help: --nr_evalue and --nr_max_target_seqs are applied while scoring
  // and reporting, not to decide what is read off disk.
  // Pool loci from ALL samples into one channel, then CHUNK them -- not into a
  // single task. Measured on embp (30,987 bp) against staph_nr:
  //
  //    threads   wall      speedup   efficiency
  //          1   4540 s      1.00x        100%
  //          4   1217 s      3.73x         93%
  //          8    717 s      6.33x         79%
  //         16    646 s      7.03x         44%
  //
  // blastx scales well to ~8 threads and badly beyond. One 16-thread task
  // leaves more than half the cores idle: 48 bp/s aggregate, versus 102 bp/s
  // from four concurrent 4-thread tasks. On a 3.08 Mb query that is 17.8 h
  // versus 8.4 h for identical work.
  //
  // Pooling across samples still matters -- it lets the chunks be even and
  // avoids 29 separate database loads -- but 'one task for everything' was
  // the wrong conclusion from it.
  nr_batch_samples = false
  // Extract and nr-search a locus for genes ALREADY CALLED PRESENT in round 1.
  // false skips them, which is cheaper but removes round 2's false-positive
  // check -- mecA was 'present' at 99.6% on a native PBP and msrA at 98.3% on
  // the housekeeping methionine sulfoxide reductase, and round 2 is what
  // exposed both. With false, such calls are reported 'present' with
  // 'round 1 only' recorded in nr_verification.
  nr_verify_present = false
  // Prebuilt nr BLAST db PREFIX, not the directory:
  //   /mnt/efs/databases/Blast/nr/db/nr
  // Empty string => NCBI remote BLAST, which is queue-dependent and can take
  // hours. Local is strongly preferred.
  nr_db     = '' //'/mnt/efs/databases/Blast/nr/db/nr' //"/mnt/efs/databases/Blast/blastdb_custom/staph_nr/staph_nr"
  // Flank around each called locus for the round-2 query. Reduced from 300.
  //
  // 300 bp pulls an adjacent gene into the query, and in an operon that gene
  // can dominate the hit list: icaD's window carried 300 bp of icaA, whose
  // 1,139 variants in staph_nr filled every target slot and left ZERO IcaD
  // hits -- a gene called present at 100% identity over 100% coverage in round
  // 1 came back 'no nr hit overlaps the called region' in all 11 carriers.
  //
  // The flank has also become largely vestigial: --min-contained-frac requires
  // a hit to sit mostly INSIDE the called region, so flank hits are discarded
  // in finalize_calls anyway. Its only remaining effect was this contamination.
  // 60 bp still absorbs a small under-call of the gene boundary by round 1,
  // while reducing a neighbour's contribution to ~20 aa -- far too short to
  // outscore the gene itself.
  flank     = 60
  hitlist   = 100          // remote mode only

  // ── Local nr search: batching ───────────────────────────────
  // blastx streams the whole database regardless of how many query sequences
  // it is given, so N loci in ONE query file cost one scan of nr instead of N.
  // With 8 genes and ~83 nr volumes on EFS that is the dominant saving.
  //   0 -> all loci in one task  (one scan; fastest, least I/O)
  //   1 -> one task per locus    (fully parallel; only helps if EFS can serve
  //                               concurrent readers)
  //   N -> batches of N
  nr_batch_size = 320      // ~1278 loci / 4 tasks
  // Concurrent readers of nr contend for EFS throughput, so cap the fan-out.
  // nr_max_forks x NR_BLASTX cpus MUST NOT EXCEED THE NODE'S CORES.
  // 2 x 4 = 8, sized for t3a.2xlarge (8 vCPU).
  //
  // On 8 cores the ceiling for a 3.08 Mb query is ~16 h however it is split
  // (8x1 threads = 15.7 h, 1x8 = 19.8 h), so configuration cannot rescue this
  // run -- the node is the constraint. A 32-core compute-optimised instance
  // (c6a/c7a.8xlarge, NOT a burstable T-series) brings it to ~4 h, and ~3.4 h
  // with flank=60.
  //
  // t3a is BURSTABLE: sustained 100% CPU exhausts the credit balance and
  // throttles to baseline, so the effective core count during a long run is
  // lower than nominal. Check CPUCreditBalance before blaming the pipeline.
  nr_max_forks  = 2

  // Mirror run_nr_verification.py's own defaults so results are unchanged.
  nr_evalue           = '1e-10'
  // Saturation by a neighbouring gene is real, and the numbers are tight:
  // staph_nr holds 1,139 records titled 'glucosamine synthase IcaA'. icaD
  // (101 aa) sits beside icaA (412 aa) in icaADBC, the flanks pull IcaA into
  // the query, and every IcaA variant outscores IcaD -- so at 100 targets,
  // zero IcaD hits were retrieved, and at 1000 still zero, because 1000 < 1139.
  //
  // Raising this is the WRONG lever: the next such pair needs a different
  // number and the output grows linearly. --flank is the cause and the fix.
  // Left at 100 deliberately.
  nr_max_target_seqs  = 100
  nr_max_hsps         = 1
  // Same reasoning as blastx_seg. Round 2 must match round 1 or the two rounds
  // measure different things: with masking on, sdrH scored 100% identity over
  // the 270 unmasked residues while the full-length figure was 89.7%, which is
  // how a worse reference came to look like an exact match.
  nr_seg              = 'no'

  // ── Round 2: interpreting nr titles ─────────────────────────
  // Most nr deflines give a product name, not a gene symbol:
  // 'accessory gene regulator B' is agrB, 'Beta-lactamase' is blaZ. Matching
  // the symbol alone falsely flagged 4 of 8 genes on LM088-RCB001 where every
  // top hit was in fact correct. bin/finalize_calls.py carries a per-gene
  // accept/reject pattern table; override or extend it with a TSV of
  // 'gene<TAB>accept<TAB>reject' regexes.
  gene_patterns = null
  // A lower-ranked hit may confirm, but only at >= this fraction of the top
  // overlapping hit's bitscore. sdrH confirms on rank 4 because ranks 1-3 are
  // the ambiguous 'fibrinogen-binding protein'.
  nr_min_bitscore_frac = 0.80
  // An nr hit counts only if >= this fraction of its own query span lies inside
  // the called region. Excludes a hit that runs out through --flank into a
  // NEIGHBOURING gene: dfrC's top hit aligned 261 aa from the gene into the
  // adjacent DegV ORF (containment 0.62) and beat the real DfrC's 161 aa
  // fully-contained alignment on bitscore alone, 428 vs 333, despite 78.2%
  // identity against 100.0%. That inflated ceiling then pushed the true hit
  // below nr_min_bitscore_frac, flagging a gene called present at 99.4%/100%.
  nr_min_contained_frac = 0.80
  // Coverage of the called region. OFF: it was the wrong hypothesis for dfrC
  // (every hit there covers 0.98 of the region, DegV included) and at 0.5 it
  // changed no call while discarding all nr evidence for aap, whose hits are
  // short relative to an 8.5 kb locus.
  nr_min_overlap_frac = 0.0
  // Below this many residues, 'no overlapping nr hit' is reported as
  // 'unverifiable_short' rather than 'flagged'. A short alignment cannot reach
  // nr_evalue: agrD is a 46-codon propeptide called present at 100%/100% in
  // round 1, which round 2 cannot assess either way. Scored 1 in the matrix
  // only when round 1 said present -- scoring 0 would assert absence on no
  // evidence, against an otherwise intact agr operon (agrB/agrC/agrA all
  // nr-confirmed).
  short_gene_aa = 80
  // Noted (not enforced) when the confirming hit's organism is outside this
  // genus -- e.g. an AgrB hit in Veillonella.
  expect_genus = 'Staphylococcus'

  // ── Runtime ─────────────────────────────────────────────────
  container = 'fischbachlab/gene-verify:latest'

  help = false
}

includeConfig "$baseDir/conf/aws_batch.config"

process {
  executor = 'awsbatch'
  queue    = 'default-maf-pipelines'
  cleanup  = true
  cache    = false

  maxRetries = 2

  // BUILD_PROTEIN_DB is the exception: it is the only networked step and the
  // only one worth reusing across -resume, so it keeps its cache.
  withName: BUILD_PROTEIN_DB {
    cache = true
  }
}

profiles {

  // Local docker on the EC2 instance -- closest to the original
  // `docker run ... run_pipeline.sh` invocation.
  local {
    process {
      executor = 'local'
      cache    = true
      cleanup  = false
    }
    docker {
      enabled    = true
      runOptions = '-v /mnt/efs:/mnt/efs:ro'   // nr lives here
    }
    // MUST match the node. These were 16 cpus / 64 GB against a t3a.2xlarge
    // that has 8 vCPU and 32 GiB -- Nextflow then believed it had twice the
    // machine it did and oversubscribed every task.
    //
    // Not I/O bound, despite the old comment here: measured at 48-52 bp/s of
    // query regardless of -seg, and a repeat run of the same locus took the
    // same time, so the database is cached and the cost is CPU.
    executor {
      cpus   = 8
      memory = '28 GB'
    }
  }

  awsbatch {
    process.executor = 'awsbatch'
    process.queue    = 'default-pipelines'
    docker.enabled   = true
    aws.region       = 'us-west-2'
  }

  // Round 1 only, no nr -- fast smoke test
  test {
    params.verify_nr = false
    params.retmax    = 5
  }
}

aws {
  region = 'us-west-2'
}

timeline { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/timeline.html" }
report   { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/report.html" }
trace    { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/trace.txt" }
dag      { enabled = false; overwrite = true; file = "$params.outdir/execution_reports/dag.html" }
